##########################################################################
# Needed by the root compose.yml
##########################################################################
## MongoDB service
MONGO_INITDB_ROOT_USERNAME=example_user
MONGO_INITDB_ROOT_PASSWORD=example_password
MONGO_INITDB_DATABASE=example_db
MONGO_PORT=27017

## Frontend service
FRONT_PORT=3000

## Backend service
API_PORT=3001
MONGO_URL=mongodb://example_user:example_password@mongodb:27017/example_db?authSource=admin
# BACKEND_URL=http://localhost:3001
INTERNAL_API_PORT=9000 # N'est pas utilisé dans le docker en develop mais le back en a besoin peu importe l'env
LANDING_PAGE_URL=http://localhost # URL de la page d'accueil du site, utilisée pour le checkout Stripe

## Monitoring services
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
CADVISOR_PORT=8080
NODE_EXPORTER_PORT=9100
MONGODB_EXPORTER_PORT=9216

## Loki & Promtail services
LOKI_PORT=3100
PROMTAIL_PORT=9080

##########################################################################
# Needed by the frontend
##########################################################################
NEXT_PUBLIC_API_URL=http://localhost:3001

##########################################################################
# Needed by the backend
##########################################################################
## General Config
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001   # used for the JWT payload

## JWT
JWT_SECRET_KEY=example_jwt_secret
JWT_EXPIRATION=2h

## SEEDER
DEFAULT_PASSWORD=example_default_password

## DB
MONGO_URL=mongodb://example_user:example_password@mongodb:27017/example_db?authSource=admin

## SMTP
SMTP_HOST=example.smtp.host
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=example_user@example.com
RECEIVER_EMAIL=receiver@example.com
SMTP_PASS=example_smtp_password

## Stripe
STRIPE_SECRET_KEY=STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=STRIPE_WEBHOOK_SECRET

##########################################################################
# Prometheus Monitoring Configuration
##########################################################################
## Global Configuration
PROMETHEUS_ENVIRONMENT=development
PROMETHEUS_MONITOR_NAME=chariot-monitor

## Storage
PROMETHEUS_RETENTION_TIME=15d

## Scrape Intervals
PROMETHEUS_SCRAPE_INTERVAL=15s
PROMETHEUS_EVALUATION_INTERVAL=15s

## AlertManager Integration
PROMETHEUS_ALERTMANAGER_TARGET=alertmanager:9093

##########################################################################
# AlertManager Configuration
##########################################################################
## SMTP Configuration (Required for alerts)
ALERTMANAGER_SMTP_FROM=contact@chariot.tools
ALERTMANAGER_SMTP_HOST=smtp.hostinger.com
ALERTMANAGER_SMTP_PORT=587
ALERTMANAGER_SMTP_USER=contact@chariot.tools
ALERTMANAGER_SMTP_PASSWORD=your_secure_smtp_password_here
ALERTMANAGER_SMTP_REQUIRE_TLS=true
ALERTMANAGER_RECEIVER_EMAIL=contact@chariot.tools

## Alert Grouping
ALERTMANAGER_GROUP_WAIT=30s
ALERTMANAGER_GROUP_INTERVAL=5m
ALERTMANAGER_REPEAT_INTERVAL=3h
ALERTMANAGER_CRITICAL_GROUP_WAIT=10s
ALERTMANAGER_CRITICAL_REPEAT_INTERVAL=30m

