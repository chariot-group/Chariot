##########################################################################
# Needed by the root compose.yml
##########################################################################

##########################################################################
# Global Configuration
##########################################################################
ENVIRONMENT=development

## SMTP
SMTP_HOST=example.smtp.host
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=example_user@example.com
RECEIVER_EMAIL=receiver@example.com
SMTP_PASSWORD=example_smtp_password

##########################################################################
# Microservices SSO
##########################################################################

# Keycloak Configuration
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=chariot
KEYCLOAK_CLIENT_ID=chariot-app
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8080
KEYCLOAK_HOSTNAME=localhost

# Keycloak SMTP Configuration
KEYCLOAK_SMTP_FROM_DISPLAY_NAME=Chariot SSO
KEYCLOAK_SMTP_FROM=contact@chariot.tools
KEYCLOAK_SMTP_REPLY_TO=contact@chariot.tools
KEYCLOAK_SMTP_REPLY_TO_DISPLAY_NAME=Chariot Support
KEYCLOAK_SMTP_STARTTLS=true
KEYCLOAK_SMTP_SSL=false

# Keycloak Database Configuration
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_DB_URL=jdbc:postgresql://keycloak-db:5432/keycloak

# Keycloak Admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_ADMIN_EMAIL=contact@chariot.tools
KEYCLOAK_ADMIN_FIRSTNAME=Chariot
KEYCLOAK_ADMIN_LASTNAME=Admin

##########################################################################
# Microservices Chariot
##########################################################################
## MongoDB service
CHARIOT_MONGO_INITDB_ROOT_USERNAME=example_user
CHARIOT_MONGO_INITDB_ROOT_PASSWORD=example_password
CHARIOT_MONGO_INITDB_DATABASE=example_db
CHARIOT_MONGO_PORT=27017
CHARIOT_MONGO_URL=mongodb://example_user:example_password@chariot-mongo:27017/example_db?authSource=admin

## Frontend service
CHARIOT_FRONT_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001
CHARIOT_FRONTEND_URL=http://localhost:3000
CHARIOT_BACKEND_URL=http://localhost:3001   # used for the JWT payload

## Backend service
CHARIOT_API_PORT=3001
CHARIOT_BACKEND_URL=http://localhost:3001
CHARIOT_INTERNAL_API_PORT=9000 # N'est pas utilisé dans le docker en develop mais le back en a besoin peu importe l'env
DEFAULT_PASSWORD=example_default_password

##########################################################################
# Microservices Monitoring
##########################################################################
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
CADVISOR_PORT=8080
NODE_EXPORTER_PORT=9100
MONGODB_EXPORTER_PORT=9216
LOKI_PORT=3100
PROMTAIL_PORT=9080

## Prometheus Configuration
PROMETHEUS_MONITOR_NAME=chariot-monitor
PROMETHEUS_SCRAPE_INTERVAL=15s
PROMETHEUS_EVALUATION_INTERVAL=15s
PROMETHEUS_ALERTMANAGER_TARGET=alertmanager:9093

PROMETHEUS_CHARIOT_BACKEND_SCRAPE_INTERVAL=10s
PROMETHEUS_CADVISOR_SCRAPE_INTERVAL=15s
PROMETHEUS_NODE_EXPORTER_SCRAPE_INTERVAL=15s
PROMETHEUS_MONGODB_SCRAPE_INTERVAL=15s
PROMETHEUS_LOKI_SCRAPE_INTERVAL=15s

PROMETHEUS_SELF_TARGET=localhost:9090
PROMETHEUS_BACKEND_TARGET=backend:9000
PROMETHEUS_BACKEND_METRICS_PATH=/metrics
PROMETHEUS_CADVISOR_TARGET=cadvisor:8080
PROMETHEUS_NODE_EXPORTER_TARGET=node-exporter:9100
PROMETHEUS_MONGODB_EXPORTER_TARGET=mongodb-exporter:9216
PROMETHEUS_ALERTMANAGER_TARGET=alertmanager:9093
PROMETHEUS_LOKI_EXPORTER_TARGET=loki:3100
PROMETHEUS_LOKI_METRICS_PATH=/loki/metrics

## Alert Manager Configuration
ALERTMANAGER_SMTP_FROM=alerts@example.com
ALERTMANAGER_TIMEOUT=10s
ALERTMANAGER_RESOLVE_TIMEOUT=5m
ALERTMANAGER_GROUP_WAIT=30s
ALERTMANAGER_GROUP_INTERVAL=5m
ALERTMANAGER_REPEAT_INTERVAL=3h
ALERTMANAGER_CRITICAL_GROUP_WAIT=10s
ALERTMANAGER_CRITICAL_REPEAT_INTERVAL=30m

## Grafana Configuration
GRAFANA_PORT=3005
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=your_secure_grafana_password_here