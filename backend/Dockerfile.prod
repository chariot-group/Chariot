FROM node:20-alpine

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm ci

COPY . .

# Voir ce qui se passe
RUN echo "=== Starting build ===" && \
    npm run build 2>&1 | tee build.log && \
    echo "=== Build finished ===" && \
    echo "=== Checking dist folder ===" && \
    ls -la dist/ && \
    ls -la dist/src/ && \
    test -f dist/src/main.js

CMD [ "node", "dist/src/main.js" ]