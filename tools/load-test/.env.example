# cp .env.example .env — ne pas committer .env

GATEWAY_URL=https://integ-api.chariot.tools
KEYCLOAK_URL=https://integ-sso.chariot.tools
# integ/prod : laisser vide | docker dev local : /auth
KEYCLOAK_AUTH_PREFIX=
KEYCLOAK_REALM=chariot
KEYCLOAK_CLIENT_ID=chariot-app

SESSION_WS_URL=https://integ-session.chariot.tools
SESSION_HTTP_URL=https://integ-session.chariot.tools
PAYMENT_HTTP_URL=https://integ-payment.chariot.tools
MINIO_PUBLIC_URL=https://integ-cdn.chariot.tools
WEB_URL=https://integ-app.chariot.tools

LOAD_TEST_USERNAME=
LOAD_TEST_PASSWORD=
LOAD_TEST_CAMPAIGN_ID=

# --- Capacité (provision / teardown) : secrets admin integ, distincts du seeder Adventure ---
LOAD_TEST_TARGET=integ
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASSWORD=
# Optionnel : nettoyage Mongo Adventure après les tests (sinon skip avec avertissement)
# ADVENTURE_MONGODB_URI=mongodb://…
