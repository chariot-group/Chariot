# cp env.example .env — ne pas committer .env
# Cible par défaut : stack Docker locale (make up ENV=dev)

WEB_URL=http://localhost:3000
GATEWAY_URL=http://localhost:8082
KEYCLOAK_URL=http://localhost:8080
# docker dev local : /auth — integ/prod : laisser vide
KEYCLOAK_AUTH_PREFIX=/auth
KEYCLOAK_REALM=chariot
KEYCLOAK_CLIENT_ID=chariot-app
LOCALE=fr

# Compte admin Keycloak (master) — sert uniquement à provisionner les comptes de test.
# Laisser vide pour désactiver le provisioning (comptes déjà existants, ex. integ).
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Comptes de test (créés automatiquement en local s'ils n'existent pas).
# Valeurs de dev uniquement — ne jamais mettre de vrais identifiants ici.
E2E_GM_USERNAME=e2e-gm
E2E_PLAYER_USERNAME=e2e-player
E2E_USER_PASSWORD=e2e-Chariot-dev-1!
