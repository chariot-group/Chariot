# cp env.example .env — ne pas committer .env
# Cible par défaut : stack Docker locale (make up ENV=dev)

WEB_URL=http://localhost:3000
GATEWAY_URL=http://localhost:8082
KEYCLOAK_URL=http://localhost:8080
# docker dev local : /auth — integ/prod : laisser vide
KEYCLOAK_AUTH_PREFIX=/auth
KEYCLOAK_REALM=chariot
KEYCLOAK_CLIENT_ID=chariot-app
LOCALE=fr

# Compte admin Keycloak (master) — sert uniquement à provisionner les comptes de test.
# Laisser vide pour désactiver le provisioning (comptes déjà existants, ex. integ).
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Comptes de test (créés automatiquement en local s'ils n'existent pas).
# Avec plusieurs workers, un compte par worker est suffixé : e2e-gm-0, e2e-gm-1…
# Valeurs de dev uniquement — ne jamais mettre de vrais identifiants ici.
E2E_GM_USERNAME=e2e-gm
E2E_PLAYER_USERNAME=e2e-player
E2E_USER_PASSWORD=e2e-Chariot-dev-1!

# Workers en parallèle (4 par défaut ; 1 forcé sans KEYCLOAK_ADMIN_*).
# E2E_WORKERS=4
# Artefacts : « all » = trace + vidéo + captures pour chaque test (défaut : sur échec seulement).
# E2E_ARTIFACTS=all

# Scénarios boutique (scenarios/boutique/) : 1 quand `make stripe-listen` relaie les webhooks Stripe
# vers la gateway (et que STRIPE_WEBHOOK_SECRET du service paiement = `stripe listen --print-secret`).
# Sans lui, les tests qui attendent un paiement confirmé (tag @webhook) ne sont pas planifiés.
# E2E_STRIPE_WEBHOOK=1

# Scénarios qui lancent une session (scenarios/personnage/repos.spec.ts, pnj-repos.spec.ts) : chaque lancement
# débite 1 wheel par participant. Les comptes de test sont crédités au besoin :
# - stack locale : avec le secret inter-services d'adventure (INTERNAL_SERVICE_SECRET de services/adventure/.env),
#   par la route interne, appelée directement sur ADVENTURE_URL ;
# - ailleurs (integ) : laisser ces deux variables vides ; avec KEYCLOAK_ADMIN_*, une commande gratuite (code promo
#   à 100 % créé par un admin jetable) crédite les wheels, sans carte ni webhook Stripe.
# Sans l'un ni l'autre, les scénarios sont sautés si le solde manque.
# ADVENTURE_URL=http://localhost:9000
# INTERNAL_SERVICE_SECRET=
