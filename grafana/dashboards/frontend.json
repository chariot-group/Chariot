{
      "title": "4. Frontend Monitoring - Next.js",
      "description": "Performance et logs du frontend",
      "id": null,
      "uid": "frontend-overview",
      "timezone": "browser",
      "schemaVersion": 37,
      "version": 1,
      "panels": [
        {
          "title": "Frontend CPU Usage",
          "type": "timeseries",
          "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
          "datasource": "Prometheus",
          "targets": [
            {
              "expr": "rate(container_cpu_usage_seconds_total{name=\"frontend\"}[5m]) * 100",
              "legendFormat": "CPU %"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "percent"
            }
          }
        },
        {
          "title": "Frontend Memory Usage",
          "type": "timeseries",
          "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
          "datasource": "Prometheus",
          "targets": [
            {
              "expr": "container_memory_usage_bytes{name=\"frontend\"} / 1024 / 1024",
              "legendFormat": "Memory (MB)"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "decmbytes"
            }
          }
        },
        {
          "title": "Frontend Build/Compilation Events",
          "type": "timeseries",
          "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
          "datasource": "Loki",
          "targets": [
            {
              "expr": "sum(count_over_time({job=\"frontend-logs\"} |~ \"(?i)(compiled|building)\" [$__interval]))",
              "legendFormat": "Build Events"
            }
          ]
        },
        {
          "title": "Frontend Errors",
          "type": "timeseries",
          "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
          "datasource": "Loki",
          "targets": [
            {
              "expr": "sum(count_over_time({job=\"frontend-logs\"} |~ \"(?i)(error|exception)\" [$__interval]))",
              "legendFormat": "Errors"
            }
          ]
        },
        {
          "title": "Frontend Network Traffic",
          "type": "timeseries",
          "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
          "datasource": "Prometheus",
          "targets": [
            {
              "expr": "rate(container_network_receive_bytes_total{name=\"frontend\"}[5m]) / 1024",
              "legendFormat": "RX (KB/s)"
            },
            {
              "expr": "rate(container_network_transmit_bytes_total{name=\"frontend\"}[5m]) / 1024",
              "legendFormat": "TX (KB/s)"
            }
          ]
        },
        {
          "title": "Recent Frontend Logs",
          "type": "logs",
          "gridPos": {"h": 10, "w": 24, "x": 0, "y": 24},
          "datasource": "Loki",
          "targets": [
            {
              "expr": "{job=\"frontend-logs\"}"
            }
          ]
        }
      ]
    }