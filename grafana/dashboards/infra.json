{
  "title": "Infrastructure Overview",
  "description": "Vue d'ensemble de l'infrastructure Docker et de l'hôte (CPU, RAM, disque, réseau, redémarrages)",
  "uid": "infra-overview",
  "timezone": "browser",
  "schemaVersion": 37,
  "version": 2,
  "panels": [
    {
      "title": "Host Network Traffic (KB/s)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "rate(node_network_receive_bytes_total{device!~\"lo|veth.*\"}[5m]) / 1024",
          "legendFormat": "RX - {{device}}"
        },
        {
          "expr": "rate(node_network_transmit_bytes_total{device!~\"lo|veth.*\"}[5m]) / 1024",
          "legendFormat": "TX - {{device}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "KBs"
        }
      }
    }
  ]
}