##########################################################################
# Prometheus Configuration
# 
# Utilisez ces valeurs comme référence pour créer .env.prometheus
# NE COMMITTEZ PAS .env.prometheus avec des secrets réels
##########################################################################

# Global labels for all metrics
PROMETHEUS_ENVIRONMENT=development
PROMETHEUS_MONITOR_NAME=chariot-monitor

# Storage configuration
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=0

# Scrape intervals (in seconds)
PROMETHEUS_SCRAPE_INTERVAL=15s
PROMETHEUS_EVALUATION_INTERVAL=15s

# Job-specific scrape intervals
PROMETHEUS_CHARIOT_BACKEND_SCRAPE_INTERVAL=10s
PROMETHEUS_MONGODB_SCRAPE_INTERVAL=15s
PROMETHEUS_CADVISOR_SCRAPE_INTERVAL=15s
PROMETHEUS_NODE_EXPORTER_SCRAPE_INTERVAL=15s

##########################################################################
# AlertManager Configuration
##########################################################################

# SMTP Configuration (required for email notifications)
# Remplacez avec vos coordonnées réelles
ALERTMANAGER_SMTP_FROM=contact@chariot.tools
ALERTMANAGER_SMTP_HOST=smtp.hostinger.com
ALERTMANAGER_SMTP_PORT=587
ALERTMANAGER_SMTP_USER=contact@chariot.tools
ALERTMANAGER_SMTP_PASSWORD=your_secure_smtp_password_here
ALERTMANAGER_SMTP_REQUIRE_TLS=true

# Alert Receiver Email
ALERTMANAGER_RECEIVER_EMAIL=contact@chariot.tools

# AlertManager timeout
ALERTMANAGER_TIMEOUT=10s

# Grouping configuration
ALERTMANAGER_GROUP_WAIT=30s
ALERTMANAGER_GROUP_INTERVAL=5m
ALERTMANAGER_REPEAT_INTERVAL=3h
ALERTMANAGER_CRITICAL_GROUP_WAIT=10s
ALERTMANAGER_CRITICAL_REPEAT_INTERVAL=30m

# Resolve timeout
ALERTMANAGER_RESOLVE_TIMEOUT=5m

##########################################################################
# Targets Configuration
##########################################################################

# Backend target
PROMETHEUS_BACKEND_TARGET=backend:9000
PROMETHEUS_BACKEND_METRICS_PATH=/metrics

# cAdvisor target
PROMETHEUS_CADVISOR_TARGET=cadvisor:8080

# Node Exporter target
PROMETHEUS_NODE_EXPORTER_TARGET=node-exporter:9100

# MongoDB Exporter target
PROMETHEUS_MONGODB_EXPORTER_TARGET=mongodb-exporter:9216

# AlertManager target
PROMETHEUS_ALERTMANAGER_TARGET=alertmanager:9093

# Prometheus self-monitoring target
PROMETHEUS_SELF_TARGET=localhost:9090
