{
      "title": "Database Monitoring",
      "description": "Performance et santé de MongoDB",
      "id": null,
      "uid": "database-overview",
      "timezone": "browser",
      "schemaVersion": 37,
      "version": 1,
      "panels": [
        {
          "title": "MongoDB Connections (from Backend)",
          "type": "timeseries",
          "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
          "datasource": "Prometheus",
          "targets": [
            {
              "expr": "chariot_mongo_connections{service=\"backend\"}",
              "legendFormat": "Active Connections"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "short"
            }
          }
        },
        {
          "title": "Backend HTTP Requests to DB",
          "type": "timeseries",
          "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
          "datasource": "Prometheus",
          "targets": [
            {
              "expr": "rate(chariot_http_requests_total{service=\"backend\"}[5m])",
              "legendFormat": "{{method}} {{route}}"
            }
          ]
        },
        {
          "title": "MongoDB Container Status",
          "type": "stat",
          "gridPos": {"h": 4, "w": 24, "x": 0, "y": 8},
          "datasource": "Prometheus",
          "targets": [
            {
              "expr": "up{job=\"node-exporter\"}",
              "legendFormat": "Infrastructure Status"
            }
          ],
          "options": {
            "colorMode": "background",
            "graphMode": "none",
            "textMode": "value_and_name"
          },
          "fieldConfig": {
            "defaults": {
              "thresholds": {
                "steps": [
                  {"value": null, "color": "red"},
                  {"value": 1, "color": "green"}
                ]
              },
              "mappings": [
                {"type": "value", "options": {"0": {"text": "Down"}}},
                {"type": "value", "options": {"1": {"text": "Running"}}}
              ]
            }
          }
        },
        {
          "type": "row",
          "title": "Note: Install MongoDB Exporter for detailed database metrics",
          "gridPos": {"h": 1, "w": 24, "x": 0, "y": 12}
        }
      ]
    }