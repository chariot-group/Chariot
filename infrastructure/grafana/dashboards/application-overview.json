{
      "title": "Application Overview",
      "description": "Dashboard principal avec vue globale de l'application",
      "id": null,
      "uid": "app-overview",
      "timezone": "browser",
      "schemaVersion": 37,
      "version": 2,
      "refresh": "5s",
      "panels": [
        {
          "id": 1,
          "title": "Services Status",
          "type": "stat",
          "gridPos": {"h": 4, "w": 12, "x": 0, "y": 0},
          "datasource": "Prometheus",
          "targets": [
            {
              "expr": "up{job=~\"chariot-backend|loki|prometheus|node-exporter\"}",
              "legendFormat": "{{job}}",
              "refId": "A"
            }
          ],
          "options": {
            "colorMode": "background",
            "graphMode": "none",
            "textMode": "value_and_name",
            "reduceOptions": {
              "values": false,
              "calcs": ["lastNotNull"]
            }
          },
          "fieldConfig": {
            "defaults": {
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {"value": null, "color": "red"},
                  {"value": 1, "color": "green"}
                ]
              },
              "mappings": [
                {"type": "value", "options": {"0": {"text": "DOWN"}}},
                {"type": "value", "options": {"1": {"text": "UP"}}}
              ]
            }
          }
        },
        {
          "id": 2,
          "title": "Average CPU Usage",
          "type": "gauge",
          "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
          "datasource": "Prometheus",
          "targets": [
            {
              "expr": "100 - (avg by(instance)(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
              "legendFormat": "{{instance}}",
              "refId": "A"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "percent",
              "thresholds": {
                "steps": [
                  {"value": 0, "color": "green"},
                  {"value": 70, "color": "yellow"},
                  {"value": 90, "color": "red"}
                ]
              },
              "max": 100
            }
          }
        },
        {
          "id": 3,
          "title": "Average Memory Usage",
          "type": "gauge",
          "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
          "datasource": "Prometheus",
          "targets": [
            {
              "expr": "100 * (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes))",
          "legendFormat": "{{instance}}",
              "refId": "A"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "percent",
              "thresholds": {
                "steps": [
                  {"value": 0, "color": "green"},
                  {"value": 80, "color": "yellow"},
                  {"value": 95, "color": "red"}
                ]
              },
              "max": 100
            }
          }
        },
        {
          "id": 4,
          "title": "Request Rate (req/s)",
          "type": "timeseries",
          "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
          "datasource": "Prometheus",
          "targets": [
            {
              "expr": "rate(chariot_http_requests_total{service=\"backend\"}[5m])",
              "legendFormat": "{{method}} {{route}}",
              "refId": "A"
            }
          ]
        },
        {
          "id": 5,
          "title": "Response Time (p95)",
          "type": "timeseries",
          "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
          "datasource": "Prometheus",
          "targets": [
            {
              "expr": "histogram_quantile(0.95, rate(chariot_http_request_duration_seconds_bucket{service=\"backend\"}[5m]))",
              "legendFormat": "{{route}}",
              "refId": "A"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "s"
            }
          }
        },
        {
          "id": 6,
          "type": "logs",
          "title": "Logs",
          "datasource": "Loki",
          "targets": [
            {
              "expr": "{job=~\"chariot-backend|chariot-frontend\"}",
              "refId": "A"
            }
          ],
          "gridPos": { "x": 0, "y": 12, "w": 24, "h": 10 }
        }
      ]
    }