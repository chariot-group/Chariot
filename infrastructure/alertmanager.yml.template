global:
  resolve_timeout: ${ALERTMANAGER_RESOLVE_TIMEOUT}
  
  # Configuration SMTP
  smtp_from: '${ALERTMANAGER_SMTP_FROM}'
  smtp_smarthost: '${SMTP_HOST}:${SMTP_PORT}'
  smtp_auth_username: '${SMTP_USER}'
  smtp_auth_password: '${SMTP_PASSWORD}'
  smtp_require_tls: ${SMTP_SECURE}

templates:
  - '/etc/alertmanager/templates/*.tmpl'

route:
  group_by: ['alertname', 'cluster', 'service']
  group_wait: ${ALERTMANAGER_GROUP_WAIT}
  group_interval: ${ALERTMANAGER_GROUP_INTERVAL}
  repeat_interval: ${ALERTMANAGER_REPEAT_INTERVAL}
  receiver: 'team-notifications'
  
  routes:
    - match:
        severity: critical
      receiver: 'critical-alerts'
      group_wait: ${ALERTMANAGER_CRITICAL_GROUP_WAIT}
      repeat_interval: ${ALERTMANAGER_CRITICAL_REPEAT_INTERVAL}

receivers:
  - name: 'team-notifications'
    email_configs:
      - to: '${RECEIVER_EMAIL}'
        send_resolved: true
        headers:
          Subject: '[Chariot] {{ .GroupLabels.alertname }}'
        html: |
          <h2>⚠️ Alerte Chariot</h2>
          <p><strong>Alertes:</strong> {{ len .Alerts }} alert(es) dans ce groupe</p>
          {{ range .Alerts }}
          <div style="margin: 10px 0; padding: 10px; border-left: 3px solid orange;">
            <p><strong>Résumé:</strong> {{ .Annotations.summary }}</p>
            <p><strong>Description:</strong> {{ .Annotations.description }}</p>
            <p><strong>Sévérité:</strong> {{ .Labels.severity }}</p>
            <p><strong>Service:</strong> {{ .Labels.service }}</p>
            <p><strong>Composant:</strong> {{ .Labels.component }}</p>
            <p><strong>Début:</strong> {{ .StartsAt }}</p>
          </div>
          {{ end }}
  
  - name: 'critical-alerts'
    email_configs:
      - to: '${RECEIVER_EMAIL}'
        send_resolved: true
        headers:
          Subject: '🚨 [CRITICAL] {{ .GroupLabels.alertname }} - ACTION REQUISE!'
        html: |
          <h1 style="color: red;">🚨 ALERTE CRITIQUE</h1>
          <p><strong>Nombre d'alertes critiques:</strong> {{ len .Alerts }}</p>
          {{ range .Alerts }}
          <div style="margin: 15px 0; padding: 15px; background-color: #ffebee; border-left: 5px solid red;">
            <h2>{{ .Labels.alertname }}</h2>
            <p><strong>Sévérité:</strong> <span style="color: red; font-weight: bold;">CRITIQUE</span></p>
            <p><strong>Résumé:</strong> {{ .Annotations.summary }}</p>
            <p><strong>Description:</strong> {{ .Annotations.description }}</p>
            <p><strong>Service:</strong> {{ .Labels.service }}</p>
            <p><strong>Composant:</strong> {{ .Labels.component }}</p>
            <p><strong>Environnement:</strong> {{ .Labels.environment }}</p>
            <p><strong>Début:</strong> {{ .StartsAt }}</p>
            {{ if .Annotations.runbook_url }}
            <p><strong>Guide de résolution:</strong> <a href="{{ .Annotations.runbook_url }}">{{ .Annotations.runbook_url }}</a></p>
            {{ end }}
          </div>
          {{ end }}
          <p style="margin-top: 20px; padding: 10px; background-color: #ffebee; border-left: 4px solid red;">
            <strong>⚡ ACTION IMMÉDIATE REQUISE</strong><br>
            Cette alerte nécessite une investigation et une résolution immédiates.
          </p>

inhibit_rules:
  - source_match:
      severity: 'critical'
      alertname: 'NodeDown'
    target_match:
      severity: 'warning'
    equal: ['instance']
  
  - source_match:
      severity: 'critical'
      alertname: 'ContainerDown'
    target_match_re:
      severity: 'warning|info'
      alertname: 'Container.*'
    equal: ['container_name']
  
  - source_match:
      severity: 'critical'
      component: 'mongodb'
      alertname: 'MongoDBDown'
    target_match:
      component: 'mongodb'
    equal: ['instance']
  
  - source_match:
      severity: 'critical'
      alertname: 'BackendDown'
    target_match_re:
      alertname: 'Backend.*'
    equal: ['service']
