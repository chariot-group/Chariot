##########################################################################
# Microservice Payment
##########################################################################

## PostgreSQL credentials
PAYMENT_POSTGRES_USER=admin
PAYMENT_POSTGRES_PASSWORD=admin
PAYMENT_POSTGRES_DB=chariot_payment
PAYMENT_DATABASE_URL=postgresql://admin:admin@chariot-payment-postgres:5432/chariot_payment

## Host URLs
PAYMENT_URL=http://chariot-payment:9003
PAYMENT_VERSION=1.0.1
FRONTEND_URL=http://localhost:3000

## Host (integ/prod uniquement - pour Traefik)
PAYMENT_HOST=payment.chariot.example.com

## Keycloak
KEYCLOAK_INTERNAL_URL=http://keycloak:8080/auth
KEYCLOAK_URL=http://localhost:8080/auth
KEYCLOAK_REALM=chariot
KEYCLOAK_CLIENT_ID=chariot-app
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

## Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
SHOWCASE_URL=http://localhost:3001
ADVENTURE_SERVICE_URL=http://chariot-adventure:9000

## Inter-service secret (doit correspondre à INTERNAL_SERVICE_SECRET dans adventure)
INTERNAL_SERVICE_SECRET=changeme

# Observability (Monitoring VPS via WireGuard)
METRICS_BASIC_AUTH_USER=prometheus
METRICS_BASIC_AUTH_PASSWORD=changeme_use_a_strong_secret
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://10.8.0.1:4318
OTEL_ENVIRONMENT=local
LOKI_ENABLED=false
LOKI_URL=http://10.8.0.1:3100
LOKI_LOG_LEVEL=info

