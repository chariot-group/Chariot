# Stage 1: Builder
FROM node:22-alpine AS builder

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /workspace

# Copier SEULEMENT les fichiers de dépendances
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY shared/package.json ./shared/
COPY services/chariot/frontend/package.json ./services/chariot/frontend/

# Installer les dépendances
RUN pnpm install --frozen-lockfile --filter @chariot/chariot-frontend...

# Copier le code source
COPY shared ./shared
COPY services/chariot/frontend ./services/chariot/frontend

# Build Next.js
WORKDIR /workspace/services/chariot/frontend
ARG NEXT_PUBLIC_API_URL
ARG CHARIOT_FRONT_PORT=3000
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
RUN pnpm run build

# Stage 2: Production
FROM node:22-alpine

RUN apk add --no-cache wget

WORKDIR /app

ARG CHARIOT_FRONT_PORT=3000

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0

# Copier les fichiers Next.js standalone
COPY --from=builder /workspace/services/chariot/frontend/.next/standalone ./
COPY --from=builder /workspace/services/chariot/frontend/.next/static ./services/chariot/frontend/.next/static
COPY --from=builder /workspace/services/chariot/frontend/public ./services/chariot/frontend/public

WORKDIR /app/services/chariot/frontend

EXPOSE ${CHARIOT_FRONT_PORT}

CMD ["node", "server.js"]