# Stage 1: Builder
FROM node:20-alpine AS builder

# Installer pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /workspace

# Copier SEULEMENT les fichiers de dépendances d'abord (pour le cache)
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY shared/package.json ./shared/
COPY services/chariot/backend/package.json ./services/chariot/backend/

# Installer les dépendances (cette étape sera cachée si les fichiers n'ont pas changé)
RUN pnpm install --frozen-lockfile --filter @chariot/chariot-backend...

# Maintenant copier le code source
COPY shared ./shared
COPY services/chariot/backend ./services/chariot/backend

# Build
WORKDIR /workspace/services/chariot/backend
RUN pnpm run build

# Stage 2: Production
FROM node:20-alpine

RUN apk add --no-cache wget

WORKDIR /app

ENV NODE_ENV=production

# Copier tous les node_modules depuis le builder (avec toutes les dépendances)
COPY --from=builder /workspace/node_modules ./node_modules
COPY --from=builder /workspace/package.json ./
COPY --from=builder /workspace/pnpm-workspace.yaml ./
COPY --from=builder /workspace/pnpm-lock.yaml ./

# Copier le code source compilé et les packages
COPY --from=builder /workspace/shared ./shared
COPY --from=builder /workspace/services/chariot/backend/dist ./services/chariot/backend/dist
COPY --from=builder /workspace/services/chariot/backend/package.json ./services/chariot/backend/

WORKDIR /app/services/chariot/backend

EXPOSE 9000

CMD ["node", "dist/main.js"]