FROM node:20-alpine AS base

WORKDIR /app

# Install dependencies (use npm install in CI to avoid lockfile mismatch)
COPY package*.json ./
# Use npm install --omit=dev to install only production deps and avoid failing when lockfile
# is out of sync with package.json in this workspace environment.
RUN npm install --omit=dev --no-audit --no-fund

COPY . .

# Build the application
RUN npm run build  && test -f dist/main.js

CMD [ "node", "dist/main.js" ]