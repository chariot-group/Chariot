# Stage 1: Builder
FROM node:20-alpine AS builder

# Installer pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /workspace

# Copier SEULEMENT les fichiers de dépendances d'abord (pour le cache)
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY shared/package.json ./shared/
COPY services/chariot/backend/package.json ./services/chariot/backend/

# Installer les dépendances (cette étape sera cachée si les fichiers n'ont pas changé)
RUN pnpm install --frozen-lockfile --filter @chariot/chariot-backend...

# Maintenant copier le code source
COPY shared ./shared
COPY services/chariot/backend ./services/chariot/backend

# Build
WORKDIR /workspace/services/chariot/backend
RUN pnpm run build

# Déployer les dépendances dans un dossier sans liens symboliques
WORKDIR /workspace
RUN pnpm --filter @chariot/chariot-backend deploy --prod /deploy/chariot-backend

# Copier les fichiers compilés dans le dossier de déploiement
RUN cp -r /workspace/services/chariot/backend/dist /deploy/chariot-backend/
RUN cp -r /workspace/shared /deploy/

# Stage 2: Production
FROM node:20-alpine

RUN apk add --no-cache wget

WORKDIR /app

ENV NODE_ENV=production

# Copier tout depuis le dossier de déploiement
COPY --from=builder /deploy/chariot-backend ./services/chariot/backend
COPY --from=builder /deploy/shared ./shared

WORKDIR /app/services/chariot/backend

EXPOSE 9000

CMD ["node", "dist/main.js"]