{
  "name": "@chariot/chariot-adventure",
  "version": "2.7.0",
  "description": "Chariot Adventure Microservice",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "seed": "ts-node -r tsconfig-paths/register src/seeder/runner/seeder.ts",
    "seed:clean": "ts-node -r tsconfig-paths/register src/seeder/runner/seeder.ts --clean",
    "format": "prettier --write .",
    "swagger:generate": "ts-node -r tsconfig-paths/register src/swagger-generator.ts"
  },
  "dependencies": {
    "@faker-js/faker": "^10.5.0",
    "@keycloak/keycloak-admin-client": "^26.7.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/mapped-types": "*",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@willsoto/nestjs-prometheus": "^6.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^4.1.0",
    "mongoose": "^9.8.0",
    "nest-winston": "^1.10.2",
    "nodemailer": "^9.0.3",
    "passport": "^0.7.0",
    "passport-keycloak-bearer": "^2.4.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.2",
    "stripe": "^22.3.2",
    "winston": "^3.17.0"
  },
  "overrides": {
    "axios": ">=1.15.0",
    "cross-spawn": "^7.0.6",
    "lodash": ">=4.18.1",
    "picomatch": ">=4.0.4",
    "path-to-regexp": "^8.4.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.28",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/mongoose": "^5.11.97",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.61.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.1",
    "typescript": "~6.0.3"
  }
}
