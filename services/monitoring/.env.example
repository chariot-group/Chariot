##########################################################################
# Exporters Prometheus (VPS Chariot) — scrape depuis Monitoring via WireGuard
##########################################################################

# MongoDB (adventure)
MONGODB_EXPORTER_URI=mongodb://user:password@chariot-mongodb-prod:27017

# Redis (session)
REDIS_EXPORTER_ADDR=redis://chariot-session-redis-prod:6379

# Postgres (session ou payment — une instance ; dupliquer le service si multi-DSN)
POSTGRES_EXPORTER_DSN=postgresql://user:password@chariot-session-postgres-prod:5432/session?sslmode=disable
