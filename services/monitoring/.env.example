##########################################################################
# Alloy (VPS Chariot) — scrape local, remote_write vers Prometheus Monitoring
##########################################################################

# Prometheus du VPS Monitoring (local : host.docker.internal ; prod : IP WireGuard)
ALLOY_REMOTE_WRITE_URL=http://host.docker.internal:9090/api/v1/write
ALLOY_REMOTE_WRITE_USER=alloy
ALLOY_REMOTE_WRITE_PASSWORD=changeme_use_a_strong_secret

# Même basic auth que les /metrics Nest
METRICS_BASIC_AUTH_USER=prometheus
METRICS_BASIC_AUTH_PASSWORD=changeme_use_a_strong_secret

# MongoDB (adventure) — hostname = container_name sur chariot-group-network
MONGODB_EXPORTER_URI=mongodb://user:password@chariot-mongodb-prod:27017/?authSource=admin

# Redis (session) — host:port, pas d'URL redis://
REDIS_ADDR=chariot-session-redis-prod:6379

# Postgres session
POSTGRES_EXPORTER_DSN=postgresql://user:password@chariot-session-postgres-prod:5432/chariot_session?sslmode=disable

# Postgres payment
POSTGRES_PAYMENT_EXPORTER_DSN=postgresql://user:password@chariot-payment-postgres-prod:5432/chariot_payment?sslmode=disable
