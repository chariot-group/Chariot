##########################################################################
# Service Admin
##########################################################################

## Gateway
GATEWAY_URL=http://localhost:8082

# URLs client (injectées aussi via compose.dev.yml)
NEXT_PUBLIC_PAYMENT_API_URL=${GATEWAY_URL}/payment
NEXT_PUBLIC_SESSION_API_URL=${GATEWAY_URL}/session
NEXT_PUBLIC_ADVENTURE_API_URL=${GATEWAY_URL}/api

## Keycloak
KEYCLOAK_URL=http://localhost:8080/auth
KEYCLOAK_REALM=chariot
KEYCLOAK_CLIENT_ID=chariot-app

## Liens externes sidebar (client Next.js)
NEXT_PUBLIC_KEYCLOAK_ADMIN_URL=http://localhost:8080/auth/admin
# En local/integ, inclure /test pour le mode test Stripe
NEXT_PUBLIC_STRIPE_DASHBOARD_URL=https://dashboard.stripe.com/test
NEXT_PUBLIC_GRAPHANA_DASHBOARD_URL=http://localhost:3005/dashboards

## Secrets GitHub (integ/prod uniquement - mêmes valeurs que ci-dessus)
# INTEG_KEYCLOAK_ADMIN_URL / PROD_KEYCLOAK_ADMIN_URL
# INTEG_STRIPE_DASHBOARD_URL / PROD_STRIPE_DASHBOARD_URL

## Host (integ/prod uniquement - pour Traefik)
ADMIN_HOST=admin.chariot.example.com
