##########################################################################
# Microservices SSO
##########################################################################

# Keycloak Configuration
KEYCLOAK_HOSTNAME=localhost
KEYCLOAK_PORT=8081

# Keycloak SMTP Configuration
KEYCLOAK_SMTP_FROM_DISPLAY_NAME=Chariot SSO 
KEYCLOAK_SMTP_FROM=contact@chariot.tools 
KEYCLOAK_SMTP_REPLY_TO=contact@chariot.tools 
KEYCLOAK_SMTP_REPLY_TO_DISPLAY_NAME=Chariot Support 
SMTP_HOST=host.com
SMTP_PORT=port 
SMTP_USER=contact@chariot.tools 
SMTP_PASSWORD=password

# Keycloak Database Configuration
KEYCLOAK_DB_NAME=keycloak 
KEYCLOAK_DB_USER=keycloak 
KEYCLOAK_DB_PASSWORD=keycloak 
KEYCLOAK_DB_URL=jdbc:postgresql://keycloak-db:5432/keycloak 

# Keycloak Admin
KEYCLOAK_ADMIN_USER=admin 
KEYCLOAK_ADMIN_PASSWORD=admin 
KEYCLOAK_ADMIN_EMAIL=contact@chariot.tools
KEYCLOAK_ADMIN_FIRSTNAME=Chariot 
KEYCLOAK_ADMIN_LASTNAME=Admin 