##########################################################################
# Microservice Media - CDN & Media API
##########################################################################

## Keycloak Authentication
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=chariot
KEYCLOAK_CLIENT_ID=chariot-app

## Inter-service secret (must match INTERNAL_SERVICE_SECRET in all services)
INTERNAL_SERVICE_SECRET=secret

## Adventure service internal URL (character ownership verification)
ADVENTURE_INTERNAL_URL=http://chariot-adventure:9000

## Session service URL (roster/session access verification)
CHARIOT_SESSION_API_URL=http://chariot-session:9002

## MinIO private media storage
MINIO_ENDPOINT=http://chariot-minio:9000
MINIO_PUBLIC_URL=http://localhost:9004
MINIO_ROOT_USER=chariot_minio
MINIO_ROOT_PASSWORD=chariot_minio_secret
MINIO_BUCKET=chariot-media
MEDIA_PRESIGNED_TTL_SECONDS=1800
