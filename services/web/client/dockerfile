FROM node:22-alpine

WORKDIR /app

# libc6-compat helps native optional deps (e.g. @parcel/watcher) on Alpine/musl
RUN apk add --no-cache libc6-compat

# Copy package files first for better caching
COPY package*.json ./

# Include optional platform binaries (@parcel/watcher-linux-*-musl, etc.)
RUN npm ci --include=optional

# Copy source code
COPY . .

EXPOSE 3000

# Dev server (webpack in Docker — Turbopack is unstable with bind mounts and high memory use)
CMD ["npm", "run", "dev:docker"]