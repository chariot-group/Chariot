    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "prettier": "^3.9.6",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.1",
    "typescript": "~6.0.3",
