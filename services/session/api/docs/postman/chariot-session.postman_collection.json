{
    "info": {
        "_postman_id": "f5d8f7c1-c2b3-4e6d-8a9b-0f1e2d3c4b5a",
        "name": "Chariot - Service Session",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
        "description": "Collection Postman complète pour tester le service Session, incluant l'API REST et les événements WebSocket."
    },
    "item": [
        {
            "name": "API REST",
            "item": [
                {
                    "name": "Sessions",
                    "item": [
                        {
                            "name": "Créer une session",
                            "request": {
                                "method": "POST",
                                "header": [],
                                "body": {
                                    "mode": "raw",
                                    "raw": "{\n    \"adventureId\": \"{{$guid}}\",\n    \"maxParticipants\": 10,\n    \"isPrivate\": false,\n    \"password\": null\n}",
                                    "options": {
                                        "raw": {
                                            "language": "json"
                                        }
                                    }
                                },
                                "url": {
                                    "raw": "{{baseUrl}}/sessions",
                                    "host": [
                                        "{{baseUrl}}"
                                    ],
                                    "path": [
                                        "sessions"
                                    ]
                                },
                                "description": "Crée une nouvelle session de jeu."
                            },
                            "response": []
                        },
                        {
                            "name": "Rejoindre une session",
                            "request": {
                                "method": "POST",
                                "header": [],
                                "body": {
                                    "mode": "raw",
                                    "raw": "{\n    \"password\": null\n}",
                                    "options": {
                                        "raw": {
                                            "language": "json"
                                        }
                                    }
                                },
                                "url": {
                                    "raw": "{{baseUrl}}/sessions/{{sessionId}}/join",
                                    "host": [
                                        "{{baseUrl}}"
                                    ],
                                    "path": [
                                        "sessions",
                                        "{{sessionId}}",
                                        "join"
                                    ]
                                },
                                "description": "Permet à un utilisateur de rejoindre une session existante."
                            },
                            "response": []
                        },
                        {
                            "name": "Lister toutes les sessions",
                            "request": {
                                "method": "GET",
                                "header": [],
                                "url": {
                                    "raw": "{{baseUrl}}/sessions",
                                    "host": [
                                        "{{baseUrl}}"
                                    ],
                                    "path": [
                                        "sessions"
                                    ]
                                },
                                "description": "Récupère la liste de toutes les sessions actives."
                            },
                            "response": []
                        },
                        {
                            "name": "Obtenir les détails d'une session",
                            "request": {
                                "method": "GET",
                                "header": [],
                                "url": {
                                    "raw": "{{baseUrl}}/sessions/{{sessionId}}",
                                    "host": [
                                        "{{baseUrl}}"
                                    ],
                                    "path": [
                                        "sessions",
                                        "{{sessionId}}"
                                    ]
                                },
                                "description": "Récupère les informations détaillées pour une session spécifique."
                            },
                            "response": []
                        },
                        {
                            "name": "Obtenir les participants d'une session",
                            "request": {
                                "method": "GET",
                                "header": [],
                                "url": {
                                    "raw": "{{baseUrl}}/sessions/{{sessionId}}/participants",
                                    "host": [
                                        "{{baseUrl}}"
                                    ],
                                    "path": [
                                        "sessions",
                                        "{{sessionId}}",
                                        "participants"
                                    ]
                                },
                                "description": "Récupère la liste des participants pour une session spécifique."
                            },
                            "response": []
                        },
                        {
                            "name": "Supprimer une session",
                            "request": {
                                "method": "DELETE",
                                "header": [],
                                "url": {
                                    "raw": "{{baseUrl}}/sessions/{{sessionId}}",
                                    "host": [
                                        "{{baseUrl}}"
                                    ],
                                    "path": [
                                        "sessions",
                                        "{{sessionId}}"
                                    ]
                                },
                                "description": "Supprime une session. Nécessite les droits d'administrateur de la session."
                            },
                            "response": []
                        }
                    ]
                },
                {
                    "name": "Général",
                    "item": [
                        {
                            "name": "Health Check",
                            "event": [
                                {
                                    "listen": "test",
                                    "script": {
                                        "exec": [
                                            "pm.test(\"Status code is 200\", function () {",
                                            "    pm.response.to.have.status(200);",
                                            "});",
                                            "",
                                            "pm.test(\"Body matches structure and content\", function () {",
                                            "    const jsonData = pm.response.json();",
                                            "    pm.expect(jsonData.status).to.eql('ok');",
                                            "    pm.expect(jsonData.service).to.eql('chariot-session');",
                                            "});"
                                        ],
                                        "type": "text/javascript"
                                    }
                                }
                            ],
                            "request": {
                                "method": "GET",
                                "header": [],
                                "url": {
                                    "raw": "{{baseUrl}}/",
                                    "host": [
                                        "{{baseUrl}}"
                                    ],
                                    "path": [
                                        ""
                                    ]
                                },
                                "description": "Vérifie que le service est bien démarré et répond correctement."
                            },
                            "response": []
                        },
                        {
                            "name": "Metrics",
                            "request": {
                                "method": "GET",
                                "header": [],
                                "url": {
                                    "raw": "{{baseUrl}}/metrics",
                                    "host": [
                                        "{{baseUrl}}"
                                    ],
                                    "path": [
                                        "metrics"
                                    ]
                                },
                                "description": "Expose les métriques du service au format Prometheus."
                            },
                            "response": []
                        }
                    ]
                }
            ]
        },
        {
            "name": "WebSocket",
            "item": [
                {
                    "name": "Connexion WebSocket",
                    "request": {
                        "url": {
                            "raw": "{{baseUrl}}",
                            "host": [
                                "{{baseUrl}}"
                            ]
                        },
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer VOTRE_TOKEN_JWT",
                                "description": "Le token d'authentification est nécessaire pour la plupart des actions."
                            }
                        ],
                        "method": "WEBSOCKET",
                        "description": "Établit une connexion WebSocket avec le service.\n\n1. Remplacez `VOTRE_TOKEN_JWT` par un token valide.\n2. Cliquez sur **Connect**.\n3. Une fois connecté, utilisez les messages ci-dessous pour interagir avec le serveur."
                    },
                    "response": {
                        "body": "{\n    \"event\": \"session:create\",\n    \"data\": {\n        \"adventureId\": \"{{$guid}}\",\n        \"maxParticipants\": 8,\n        \"isPrivate\": false\n    }\n}",
                        "ws": {
                            "message": [
                                {
                                    "body": "{\n    \"event\": \"session:create\",\n    \"data\": {\n        \"adventureId\": \"{{$guid}}\",\n        \"maxParticipants\": 8,\n        \"isPrivate\": false\n    }\n}"
                                },
                                {
                                    "body": "{\n    \"event\": \"session:join\",\n    \"data\": {\n        \"sessionId\": \"{{sessionId}}\"\n    }\n}"
                                },
                                {
                                    "body": "{\n    \"event\": \"session:leave\",\n    \"data\": {\n        \"sessionId\": \"{{sessionId}}\"\n    }\n}"
                                },
                                {
                                    "body": "{\n    \"event\": \"session:launch\",\n    \"data\": {\n        \"sessionId\": \"{{sessionId}}\"\n    }\n}"
                                }
                            ]
                        }
                    }
                }
            ],
            "description": "Requêtes pour le serveur WebSocket du service Session"
        }
    ],
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:3001",
            "type": "string",
            "description": "L'URL de base de votre service Session. Changez le port si nécessaire."
        },
        {
            "key": "sessionId",
            "value": "ID_DE_SESSION_A_REMPLACER",
            "type": "string",
            "description": "Variable pour stocker l'ID de la session à tester."
        }
    ]
}