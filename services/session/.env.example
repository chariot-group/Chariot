##########################################################################
# Microservice Session
##########################################################################

## PostgreSQL credentials
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=chariot_session
DATABASE_URL=postgresql://admin:admin@chariot-session-postgres:5432/chariot_session

## Redis
REDIS_URL=redis://chariot-session-redis:6379

## Host URLs
SESSION_URL=http://chariot-session:9002
SESSION_VERSION=1.2.1
SESSION_HOST=session.chariot.example.com
FRONTEND_URL=http://localhost:3000

## Keycloak
KEYCLOAK_INTERNAL_URL=http://keycloak:8080/auth
KEYCLOAK_URL=http://localhost:8080/auth
KEYCLOAK_REALM=chariot
KEYCLOAK_CLIENT_ID=chariot-app
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

## Adventure API (vérification du solde de tokens à l'entrée en session)
ADVENTURE_SERVICE_URL=http://chariot-adventure:9000
INTERNAL_SERVICE_SECRET=secret

# Observability (Monitoring VPS via WireGuard)
METRICS_BASIC_AUTH_USER=prometheus
METRICS_BASIC_AUTH_PASSWORD=changeme_use_a_strong_secret
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://10.8.0.1:4318
OTEL_ENVIRONMENT=local
LOKI_ENABLED=false
LOKI_URL=http://10.8.0.1:3100
LOKI_LOG_LEVEL=info

