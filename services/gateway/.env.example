# Gateway Service Environment Variables

# Gateway Configuration
GATEWAY_PORT=8082
GATEWAY_LOG_LEVEL=debug
GATEWAY_RATE_LIMIT_MAX=100
GATEWAY_RATE_LIMIT_WINDOW=60000

# Gateway Host (for production/integration with Traefik)
GATEWAY_HOST=localhost:8082

# Backend Services
# Format: {SERVICE_NAME}_SERVICE_URL where SERVICE_NAME is uppercase with underscores
# The service name in URLs will be lowercase with hyphens (e.g., ADVENTURE -> adventure)
# Routing: /api/* → adventure, /session/* → session
ADVENTURE_SERVICE_URL=http://chariot-adventure:9000
SESSION_SERVICE_URL=http://chariot-session:9002
PAYMENT_SERVICE_URL=http://chariot-payment:9003
MEDIA_SERVICE_URL=http://chariot-media:9005

# Frontend CORS
FRONTEND_URL=http://localhost:3000

# Keycloak Authentication
KEYCLOAK_URL=http://localhost:8080/auth
KEYCLOAK_REALM=chariot
KEYCLOAK_INTERNAL_URL=http://keycloak:8080/auth

# Observability (Monitoring VPS via WireGuard)
METRICS_BASIC_AUTH_USER=prometheus
METRICS_BASIC_AUTH_PASSWORD=changeme_use_a_strong_secret
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://10.8.0.1:4318
OTEL_ENVIRONMENT=local
LOKI_ENABLED=false
LOKI_URL=http://10.8.0.1:3100
LOKI_LOG_LEVEL=info

