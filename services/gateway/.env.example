# Gateway Service Environment Variables

# Gateway Configuration
GATEWAY_PORT=8082
GATEWAY_LOG_LEVEL=debug
GATEWAY_RATE_LIMIT_MAX=100
GATEWAY_RATE_LIMIT_WINDOW=60000

# Backend Services
ADVENTURE_SERVICE_URL=http://chariot-adventure:9000

# Frontend CORS
FRONTEND_URL=http://localhost:3000

# Keycloak Authentication
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=chariot
KEYCLOAK_INTERNAL_URL=http://chariot-keycloak:8080
