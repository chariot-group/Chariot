{
  "name": "@chariot/monorepo",
  "version": "1.0.0",
  "description": "Chariot Microservices Monorepo",
  "private": true,
  "scripts": {
    "dev": "docker compose up",
    "dev:chariot": "docker compose --profile chariot up",
    "dev:infra": "docker compose --profile infrastructure up",
    "prod": "docker compose -f compose.yml -f compose.prod.yml up",
    "integ": "docker compose -f compose.yml -f compose.integ.yml up",
    "down": "docker compose down",
    "clean": "docker compose down -v",
    "logs": "docker compose logs -f",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "jws": ">=3.2.3",
      "body-parser": ">=2.2.1"
    }
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.22.0+sha512.bf049efe995b28f527fd2b41ae0474ce29186f7edcb3bf545087bd61fbbebb2bf75362d1307fda09c2d288e1e499787ac12d4fcb617a974718a6051f2eee741c"
}
